  "targets": [
    {
      "name": "BeerMaisVisualTests",
      "id": "BCE300000000000000000001",
      "product": "Products/BeerMaisVisualTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "BeerMais",
      "dependencies": [
        "BeerMais",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "swift-snapshot-testing",
          "product-name": "SnapshotTesting",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "GENERATE_INFOPLIST_FILE": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "18.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "br.com.joseneves.BeerMaisVisualTests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/BeerMais.app/BeerMais",
      },
    }, {
      "name": "BeerMais",
      "id": "2D1D3E4321F670C9008F51AC",
      "product": "Products/BeerMais.app",
      "product-type": "application",
      "last-swift-migration": "10.2",
      "dependencies": [
        "BeerMais Clip",
        "BeerMais widgetExtension",
      ],
      "build-phases": [
        {
          "kind": "script",
          "name": "Copy plists Script",
          "log-environment-variables": true,
          "shell": "/bin/sh",
          "script": [
            "PATH_TO_PLISTS=\"${PROJECT_DIR}/BeerMais/Property lists\"",
            "",
            "case \"${CONFIGURATION}\" in",
            "",
            "   \"Debug\" )",
            "        cp -r \"$PATH_TO_PLISTS/Dev/GoogleService-Info.plist\" \"${BUILT_PRODUCTS_DIR}/${PRODUCT_NAME}.app/GoogleService-Info.plist\" ",
            "        ",
            "        cp -r \"$PATH_TO_PLISTS/Dev/Settings.plist\" \"${BUILT_PRODUCTS_DIR}/${PRODUCT_NAME}.app/Settings.plist\" ;;",
            "",
            "   \"Release\" )",
            "        cp -r \"$PATH_TO_PLISTS/Prod/GoogleService-Info.plist\" \"${BUILT_PRODUCTS_DIR}/${PRODUCT_NAME}.app/GoogleService-Info.plist\" ",
            "        ",
            "        cp -r \"$PATH_TO_PLISTS/Prod/Settings.plist\" \"${BUILT_PRODUCTS_DIR}/${PRODUCT_NAME}.app/Settings.plist\" ;;",
            "",
            "    *)",
            "        ;;",
            "esac",
            "",
          ],
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Embed App Clips",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/AppClips",
        },
      ],
      "package-product-members": [
        {
          "package": "Amplitude-Swift",
          "product-name": "AmplitudeSwift",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "BasicsKit",
          "product-name": "BasicsKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseCrashlytics",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseMessaging",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseRemoteConfig",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "lottie-spm",
          "product-name": "Lottie",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-package-manager-google-mobile-ads",
          "product-name": "GoogleMobileAds",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "icon-glass",
        "ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS": "NO",
        "CODE_SIGN_ENTITLEMENTS": "BeerMais/Config/BeerMais.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "50",
        "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf-with-dsym",
        "DEVELOPMENT_TEAM": "2LEA6X25G9",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
