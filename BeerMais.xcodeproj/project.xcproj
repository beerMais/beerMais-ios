    }, {
      "name": "BeerMais Clip",
      "id": "A18158AC2597D1D4004B2018",
      "product": "Products/BeerMais Clip.app",
      "product-type": "application.on-demand-install-capable",
      "build-phases": [
        {
          "kind": "script",
          "name": "Copy plists",
          "log-environment-variables": true,
          "shell": "/bin/sh",
          "script": [
            "PATH_TO_PLISTS=\"${SRCROOT}/BeerMais/Property lists\"",
            "",
            "case \"${CONFIGURATION}\" in",
            "",
            "   \"DEBUG_APPCLIP\"|\"Debug\" )",
            "        ",
            "        cp -r \"$PATH_TO_PLISTS/Dev/GoogleService-Info.plist\" \"${BUILT_PRODUCTS_DIR}/${PRODUCT_NAME}.app/GoogleService-Info.plist\" ",
            "        ",
            "        cp -r \"$PATH_TO_PLISTS/Dev/Settings.plist\" \"${BUILT_PRODUCTS_DIR}/${PRODUCT_NAME}.app/Settings.plist\" ;;",
            "",
            "   \"APPCLIP\"|\"Release\" )",
            "        ",
            "        cp -r \"$PATH_TO_PLISTS/Prod/GoogleService-Info.plist\" \"${BUILT_PRODUCTS_DIR}/${PRODUCT_NAME}.app/GoogleService-Info.plist\" ",
            "        ",
            "        cp -r \"$PATH_TO_PLISTS/Prod/Settings.plist\" \"${BUILT_PRODUCTS_DIR}/${PRODUCT_NAME}.app/Settings.plist\" ;;",
            "",
            "    *)",
            "        ;;",
            "esac",
            "",
          ],
        },
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "Amplitude-Swift",
          "product-name": "AmplitudeSwift",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "BasicsKit",
          "product-name": "BasicsKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseRemoteConfig",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-package-manager-google-mobile-ads",
          "product-name": "GoogleMobileAds",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "icon-glass",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "primary",
        "CODE_SIGN_ENTITLEMENTS[config=Debug]": "BeerMais Clip/BeerMais_Clip-debug.entitlements",
